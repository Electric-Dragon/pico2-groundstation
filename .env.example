# Copy to .env and uncomment what you want to change.
# Values shown are the defaults. Empty or missing means the default.
# Command-line flags override these, and real environment variables override .env.

# ---- firmware / wire protocol (must match the Pico) ----
# GCS_PORT=5005
# Header magic and version. Empty = don't check. Hex is fine, e.g. 0x5053.
# GCS_MAGIC=
# GCS_VERSION=
# Which cam_id is the left camera and which is the right.
# GCS_CAM_LEFT=0
# GCS_CAM_RIGHT=1

# ---- network ----
# GCS_HOST=0.0.0.0
# Only accept packets from this IP (the Pico). Empty = any sender.
# GCS_SOURCE=
# OS receive buffer in bytes.
# GCS_RCVBUF=4194304

# ---- frame assembly ----
# Drop a frame still missing chunks after this many seconds.
# GCS_FRAME_TIMEOUT_S=0.5
# Drop a pair whose left/right capture times differ by more than this.
# GCS_MAX_SKEW_US=1000

# ---- calibration / rectification ----
# Calibration images go in <dir>/calib/, results in <dir>/calib.npz.
# GCS_DATA_DIR=data
# Board inner corners, COLSxROWS.
# GCS_PATTERN=8x5
# Measured square size in mm. Required for `calibrate solve` (here or as --square-mm).
# GCS_SQUARE_MM=
# 0 = crop rectified images to valid pixels, 1 = keep the full view.
# GCS_ALPHA=0
